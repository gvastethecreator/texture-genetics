{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Dev Server",
            "type": "shell",
            "command": "bun run dev",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "📦 Build",
            "type": "shell",
            "command": "bun run build 2>&1 | Tee-Object -FilePath logs/build.log",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$tsc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
