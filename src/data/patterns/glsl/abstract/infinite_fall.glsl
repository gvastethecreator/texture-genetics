float getPattern(vec2 uv) { vec2 u = (uv - 0.5) * 2.0; float t = u_time * 2.0; float ang = u_time * (u_factor - 0.5); float s = sin(ang); float c = cos(ang); u = mat2(c,-s,s,c) * u; u *= u_scale; float v = 0.0; float tot = 0.0; mat2 M = mat2(cos(1.7),sin(1.7),-sin(1.7),cos(1.7)); for(float i=0.0; i<20.0; i++) { float k = i - t; float a = 1.0 - cos(6.2831 * k / 20.0); float sc = exp2(mod(k, 20.0)); float n = noise(u * sc * 0.2); v += a/sc * (1.0 - abs(2.0 * n - 1.0)); tot += a/sc; u = M * u; } return pow(clamp(1.5 * v / tot, 0.0, 1.0), u_intensity); }