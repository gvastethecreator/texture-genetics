float getPattern(vec2 uv) { vec2 u = (uv - 0.5) * 4.0 * u_scale; float v = 0.0; float freq = 6.0 + u_factor * 10.0; for(float i=-2.0; i<=2.0; i++) { for(float j=-2.0; j<=2.0; j++) { vec2 offset = vec2(i, j) * 0.7; vec2 p = u - offset; float len = dot(p, p); float wave = sin(freq * dot(p, vec2(cos(u_time), sin(u_time)))); v += exp(-2.0 * len) * wave; } } return clamp(0.5 + 0.5 * v, 0.0, 1.0) * u_intensity; }