float getSwirl(vec2 uv) { vec2 st = (uv - 0.5) * 2.0; float r = length(st); float a = atan(st.y, st.x) + r * u_factor * 5.0 - u_time; st = vec2(cos(a), sin(a)) * r; st = st * 0.5 + 0.5; float val = st.x * st.y; return smoothstep(0.2, 0.8, val); } float getPattern(vec2 uv) { float s = getSwirl(uv * u_scale); if (u_detail > 0.0) { float s2 = getSwirl(uv * u_scale * 1.5 + vec2(0.2)); s = mix(s, s2, u_detail); } return pow(clamp(s, 0.0, 1.0), u_intensity); }