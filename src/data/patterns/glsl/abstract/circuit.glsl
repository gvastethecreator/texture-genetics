float getPattern(vec2 uv) { vec2 u=uv*u_scale*10.0; vec2 i=floor(u); vec2 f=fract(u); float r=random(i); float v=0.0; float thick = 0.05 + 0.1*u_factor; if(r<0.5) v=step(abs(f.x-0.5), thick); else v=step(abs(f.y-0.5), thick); if(random(i+1.0)>0.8) v+=step(length(f-0.5), 0.2 + u_p10 * 0.2); if(u_p6 > 0.0 && v > 0.5) v *= random(i + floor(u_time * 5.0)) > (1.0-u_p6) ? 1.0 : 0.0; return pow(clamp(v, 0.0, 1.0), u_intensity); }