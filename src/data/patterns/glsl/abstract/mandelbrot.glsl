float getPattern(vec2 uv) { vec2 c = (uv - 0.5) * 3.0 / u_scale - vec2(0.5, 0.0) + u_offset; vec2 z = vec2(0.0); float iter = 0.0; float maxIter = 20.0 + u_detail * 80.0; for(float i=0.0; i<100.0; i++){ if(i > maxIter) break; z = vec2(z.x*z.x - z.y*z.y, 2.0*z.x*z.y) + c; if(dot(z,z) > 4.0) break; iter++; } return pow(clamp(iter/maxIter, 0.0, 1.0), u_intensity) * (1.0 + u_factor * sin(iter)); }