float getPattern(vec2 uv) { vec2 u = (uv * 2.0 - 1.0) * u_scale; float t = u_time * 0.5 * u_speed; float v = 0.0; float layers = 2.0 + floor(u_factor * 6.0); for(float i = 1.0; i < 8.0; i++){ if(i > layers) break; u.y += i * 0.1 / i * sin(u.x * i * i + t) * sin(u.y * i * i + t); } float r = u.y - 0.1; float g = u.y + 0.3; float b = u.y + 0.95; float combined = (r + g + b) / 3.0; return clamp(combined, 0.0, 1.0) * u_intensity; }