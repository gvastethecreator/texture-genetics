float getPattern(vec2 uv) { vec2 u=uv*u_scale*5.0; u.y+=u_time*(1.0+u_p4); if(u_p5 > 0.0) u.x += sin(u.y * 2.0 + u_time) * u_p5 * 0.2; vec2 f=fract(u); float b=0.0; if(random(floor(u))>0.9-u_factor*0.3){ vec2 c=vec2(0.5)+vec2(sin(u_time*5.0+random(floor(u))*10.0)*0.2,0.0); float d=length(f-c); float sharp = 0.35 - u_p2 * 0.1; b=smoothstep(0.4,sharp,d)-smoothstep(0.3,0.25,d); if(u_p6 > 0.0) b += smoothstep(0.1,0.0,distance(f,c-0.1))*u_p6; } return clamp(b*u_intensity,0.0,1.0); }