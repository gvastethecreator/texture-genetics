float getPattern(vec2 uv) { vec2 u=uv*u_scale*5.0; float t=u_time*0.5*u_speed; vec2 i=u; float c=1.0; float k=0.05 + u_p3 * 0.1; for(int n=0;n<4;n++){ float t2=t*(1.0-(3.0/float(n+1))); i=u+vec2(cos(t2-i.x)+sin(t2+i.y),sin(t2-i.y)+cos(t2+i.x)); c+=1.0/max(0.01, length(vec2(u.x/(sin(i.x+t2)/k),u.y/(cos(i.y+t2)/k)))); } c/=4.0; float val = 1.5-sqrt(c); if(u_p2 > 0.0) val = pow(max(0.0, val), 1.0 + u_p2 * 2.0); return pow(clamp(val,0.0,1.0),u_intensity*(1.0+u_factor)); }