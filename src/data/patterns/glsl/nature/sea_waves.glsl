float sea_octave(vec2 uv, float choppy) { uv += noise(uv); vec2 wv = 1.0-abs(sin(uv)); vec2 swv = abs(cos(uv)); wv = mix(wv,swv,wv); return pow(max(0.0, 1.0-pow(max(0.0, wv.x * wv.y),0.65)),choppy); } float getPattern(vec2 uv) { float freq = 0.5 * u_scale; float amp = 0.6; float choppy = 4.0 * u_factor; vec2 p = uv * 5.0; float h = 0.0; float t = u_time * u_speed; mat2 m = mat2(1.6,1.2,-1.2,1.6); for(int i = 0; i < 4; i++) { float d = sea_octave((p+t)*freq, choppy); d += sea_octave((p-t)*freq, choppy); h += d * amp; p *= m; freq *= 1.9; amp *= 0.22; choppy = mix(choppy,1.0,0.2); } if(u_p2 > 0.0) h = h * (1.0 + u_p2 * 2.0); return pow(clamp(h * 0.5, 0.0, 1.0), u_intensity); }