float getPattern(vec2 uv) { vec2 p=uv*u_scale*3.0; float d=0.3*u_factor; float spd = u_speed; for(int i=1;i<5;i++){ p.x+=d/float(i)*sin(float(i)*3.0*p.y+u_time*spd*u_p4); p.y+=d/float(i)*cos(float(i)*3.0*p.x+u_time*spd*u_p5); } float v = 0.5+0.5*sin(p.x+p.y); if(u_p7 > 0.0) v = mix(v, step(0.8 - u_p7 * 0.3, v), 0.5); if(u_p2 > 0.0) v = pow(max(0.0, v), 1.0 + u_p2); return pow(clamp(v, 0.0, 1.0),u_intensity); }