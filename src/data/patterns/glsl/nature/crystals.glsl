float getPattern(vec2 uv) { vec2 u = uv * u_scale * 4.0; vec2 n = floor(u); vec2 f = fract(u); float m_dist = 1.0; vec2 m_point = vec2(0.0); for(int j=-1; j<=1; j++) { for(int i=-1; i<=1; i++) { vec2 g = vec2(float(i),float(j)); vec2 o = vec2(random(n + g)); o = 0.5 + 0.5*sin(u_time*0.5 + 6.2831*o); vec2 r = g + o - f; float d = dot(r,r); if( d<m_dist ) { m_dist = d; m_point = n + g + o; } } } float val = random(m_point); float edge = smoothstep(0.0, 0.1 * (1.0-u_factor), m_dist); return pow(clamp(val * (1.0 - edge * u_detail), 0.0, 1.0), u_intensity); }