float getPattern(vec2 uv) { vec2 u = uv * u_scale * 10.0; vec2 p0 = floor(u); float circles = 0.0; float chaos = u_p6; float freq = 10.0 + u_p10 * 20.0; for (int j = -2; j <= 2; ++j) { for (int i = -2; i <= 2; ++i) { vec2 pi = p0 + vec2(float(i), float(j)); vec2 hsh = pi; vec2 p = pi + hash22(hsh); float t = fract(0.3 * u_time * u_speed + hash12(hsh) * u_p5); vec2 v = p - u; float d = length(v); float radius = 3.0 * t * (1.0 + u_p3); float wave = sin(freq * (d - radius)); wave *= smoothstep(0.0, -0.3, d - radius) * smoothstep(-0.6, -0.3, d - radius); wave *= (1.0 - t * (1.0 + u_p2)); circles += wave; } } return clamp(circles * 0.5 + 0.5, 0.0, 1.0) * u_intensity; }