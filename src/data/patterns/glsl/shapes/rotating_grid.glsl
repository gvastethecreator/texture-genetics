float circleShape(vec2 uv, float radius) { vec2 dist = uv - vec2(0.5); float angle = atan(dist.y, dist.x); if (u_factor > 0.5 && angle < -1.57) return 0.0; return 1.0 - smoothstep(radius - 0.01, radius + 0.01, dot(dist,dist)*4.0); } float getPattern(vec2 uv) { vec2 u = uv * 8.0 * u_scale; vec2 index = floor(u); vec2 f = fract(u); float check = mod(index.x + index.y, 2.0); float angle = u_time * u_speed; if(check > 0.5) angle *= -1.0; f -= 0.5; f = mat2(cos(angle), -sin(angle), sin(angle), cos(angle)) * f; f += 0.5; float c = circleShape(f, 0.8 * u_detail); return pow(clamp(c, 0.0, 1.0), u_intensity); }