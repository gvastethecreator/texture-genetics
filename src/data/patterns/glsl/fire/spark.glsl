float getPattern(vec2 uv) { vec2 u=(uv-0.5)*u_scale; if(u_p2 > 0.0) u = rotate2d(u_time * u_p2) * u; float d=length(u); float rays = u_p1 > 0.0 ? abs(sin(atan(u.y,u.x) * (4.0 + floor(u_p1 * 10.0)))) : 1.0; float s=0.02/max(0.001, d); s *= mix(1.0, rays, u_p1); s=mix(s,s+0.005/max(0.001, abs(u.x*u.y)),u_factor); return pow(clamp(s*(0.8+0.2*noise(u*10.0+u_time*5.0)),0.0,1.0),u_intensity); }