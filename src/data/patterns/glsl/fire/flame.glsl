float getPattern(vec2 uv) { vec2 u = uv; float wind = sin(u.y * 10.0 + u_time * 5.0) * 0.05 * u_p2; u.x += wind; float n = fbm(u * 5.0 * u_scale - vec2(0, u_time * 2.0)); float h = 1.0 - (u_p1 * 0.5); float baseW = 0.5 + u_p5 * 0.5; float shape = 1.0 - distance(vec2(u.x, u.y * h + 0.5), vec2(0.5, 1.0)); shape = smoothstep(0.0, baseW, shape); float f = shape + n * (0.2 + u_factor * 0.5); return pow(clamp(f, 0.0, 1.0), 4.0 / max(0.01, u_intensity)); }