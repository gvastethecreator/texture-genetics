# ============================================================
# EffectTextureGen — .gitignore
# ============================================================

# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
resources/*

# ── Build output ────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Logs ────────────────────────────────────────────────────
logs/*.log
logs/**/*.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# ── Test & Coverage ─────────────────────────────────────────
coverage/
*.lcov

# ── Cache ───────────────────────────────────────────────────
.vite/
.cache/
.turbo/
.playwright-mcp/
.agents/
*.tsbuildinfo

# ── Editor / IDE ────────────────────────────────────────────
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Environment variables ───────────────────────────────────
.env
.env.*
!.env.example

# ── Temporary / backup files ────────────────────────────────
*.tmp
*.temp
*.bak
*.orig

# ── Package manager locks (Bun is canonical) ────────────────
package-lock.json
yarn.lock
pnpm-lock.yaml
