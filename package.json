{
  "name": "effecttexturegen",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based procedural texture generation workstation (TSL/GLSL, Three.js, React).",
  "author": "gvastethecreator",
  "license": "MIT",
  "homepage": "https://github.com/gvastethecreator/texture-genetics#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/texture-genetics.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/texture-genetics/issues"
  },
  "keywords": [
    "procedural-texture",
    "texture-generation",
    "shader",
    "glsl",
    "tsl",
    "threejs",
    "react",
    "pbr",
    "normal-map",
    "sprite-sheet",
    "game-dev"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/run-with-log.mjs build.log vite build",
    "preview": "vite preview",
    "lint": "node ./scripts/run-with-log.mjs lint.log oxlint src/ --tsconfig tsconfig.json",
    "lint:fix": "node ./scripts/run-with-log.mjs lint-fix.log oxlint src/ --tsconfig tsconfig.json --fix",
    "fmt": "node ./scripts/run-with-log.mjs format-write.log --shell \"oxfmt --write \\\"src/**/*.{ts,tsx}\\\"\"",
    "fmt:check": "node ./scripts/run-with-log.mjs format.log --shell \"oxfmt --check \\\"src/**/*.{ts,tsx}\\\"\"",
    "check": "node ./scripts/run-with-log.mjs check.log --shell \"bun run lint && bun run fmt:check && bun run typecheck\"",
    "typecheck": "node ./scripts/run-with-log.mjs typecheck.log tsc --noEmit",
    "test": "node ./scripts/run-with-log.mjs test.log vitest run",
    "test:watch": "vitest",
    "test:coverage": "node ./scripts/run-with-log.mjs test-coverage.log vitest run --coverage",
    "clean": "node ./scripts/clean.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.2.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "modern-gif": "^2.1.0",
    "postprocessing": "^6.39.1",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.67.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
