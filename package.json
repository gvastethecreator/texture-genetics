{
  "name": "texture-genetics",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "description": "Texture Genetics browser workstation for procedural textures, animated materials, and PBR exports.",
  "author": "gvastethecreator",
  "license": "MIT",
  "homepage": "https://gvastethecreator.github.io/texture-genetics/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gvastethecreator/texture-genetics.git"
  },
  "bugs": {
    "url": "https://github.com/gvastethecreator/texture-genetics/issues"
  },
  "keywords": [
    "procedural-texture",
    "texture-generation",
    "shader",
    "glsl",
    "tsl",
    "threejs",
    "react",
    "pbr",
    "normal-map",
    "sprite-sheet",
    "game-dev"
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "postprocessing": "^6.39.4",
    "undici": "^8.10.0",
    "vite": "^8.2.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/run-with-log.mjs build.log --shell \"vite build && node ./scripts/check-build-budget.mjs\"",
    "build:budget": "node ./scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "lint": "node ./scripts/run-with-log.mjs lint.log oxlint src/ --tsconfig tsconfig.json",
    "lint:fix": "node ./scripts/run-with-log.mjs lint-fix.log oxlint src/ --tsconfig tsconfig.json --fix",
    "fmt": "node ./scripts/run-with-log.mjs format-write.log --shell \"oxfmt --write \\\"src/**/*.{ts,tsx}\\\"\"",
    "fmt:check": "node ./scripts/run-with-log.mjs format.log --shell \"oxfmt --check \\\"src/**/*.{ts,tsx}\\\"\"",
    "check": "node ./scripts/run-with-log.mjs check.log --shell \"pnpm run lint && pnpm run fmt:check && pnpm run typecheck\"",
    "typecheck": "node ./scripts/run-with-log.mjs typecheck.log tsc --noEmit",
    "test": "node ./scripts/run-with-log.mjs test.log vitest run",
    "test:watch": "vitest",
    "test:coverage": "node ./scripts/run-with-log.mjs test-coverage.log vitest run --coverage",
    "clean": "node ./scripts/clean.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "modern-gif": "^2.1.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "5.0.0"
  }
}
