{
  "name": "effecttexturegen",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/run-with-log.mjs build.log vite build",
    "preview": "vite preview",
    "lint": "node ./scripts/run-with-log.mjs lint.log oxlint src/ --tsconfig tsconfig.json",
    "lint:fix": "node ./scripts/run-with-log.mjs lint-fix.log oxlint src/ --tsconfig tsconfig.json --fix",
    "fmt": "node ./scripts/run-with-log.mjs format-write.log --shell \"oxfmt --write \\\"src/**/*.{ts,tsx}\\\"\"",
    "fmt:check": "node ./scripts/run-with-log.mjs format.log --shell \"oxfmt --check \\\"src/**/*.{ts,tsx}\\\"\"",
    "check": "node ./scripts/run-with-log.mjs check.log --shell \"bun run lint && bun run fmt:check && bun run typecheck\"",
    "typecheck": "node ./scripts/run-with-log.mjs typecheck.log tsc --noEmit",
    "test": "node ./scripts/run-with-log.mjs test.log vitest run",
    "test:watch": "vitest",
    "test:coverage": "node ./scripts/run-with-log.mjs test-coverage.log vitest run --coverage",
    "clean": "node ./scripts/clean.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@react-three/postprocessing": "^3.0.4",
    "gsap": "^3.12.7",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.560.0",
    "modern-gif": "^2.0.4",
    "postprocessing": "^6.38.0",
    "react": "^19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.1.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "oxfmt": "0.42.0",
    "oxlint": "1.57.0",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.8.2",
    "vite": "^8.0.3",
    "vitest": "^3.2.4"
  }
}