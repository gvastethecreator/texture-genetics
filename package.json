{
  "name": "effecttexturegen",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src/ --tsconfig tsconfig.json",
    "lint:fix": "oxlint src/ --tsconfig tsconfig.json --fix",
    "fmt": "oxfmt --write \"src/**/*.{ts,tsx}\"",
    "fmt:check": "oxfmt --check \"src/**/*.{ts,tsx}\"",
    "check": "bun run lint && bun run fmt:check && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist logs coverage .vite node_modules/.vite"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@react-three/postprocessing": "^3.0.4",
    "gsap": "^3.12.7",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.560.0",
    "postprocessing": "^6.38.0",
    "react": "^19.1.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.1.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "jsdom": "^26.1.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.8.2",
    "vite": "^8.0.1",
    "vitest": "^3.1.1"
  }
}